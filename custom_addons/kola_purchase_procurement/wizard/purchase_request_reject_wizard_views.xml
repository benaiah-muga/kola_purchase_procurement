<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Whole-request rejection -->
    <record id="view_purchase_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.reject.wizard.form</field>
        <field name="model">purchase.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Request">
                <div class="alert alert-warning" role="alert">
                    Please provide a reason for rejecting this purchase request. It will be stored on the request and tracked in the chatter.
                </div>
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="Explain why this request is being rejected..." nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_request_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Purchase Request</field>
        <field name="res_model">purchase.request.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_purchase_request"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- Line-level rejection -->
    <record id="view_purchase_request_line_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.line.reject.wizard.form</field>
        <field name="model">purchase.request.line.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request Line">
                <div class="alert alert-warning" role="alert">
                    Please provide a reason for rejecting the selected line(s). Rejected lines will not be sent to vendors when the RFQ is created.
                </div>
                <group>
                    <field name="line_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Explain why this line is being rejected..." nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_request_line_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Request Line</field>
        <field name="res_model">purchase.request.line.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_purchase_request_line"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
