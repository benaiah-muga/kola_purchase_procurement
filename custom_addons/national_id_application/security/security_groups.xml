<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_national_id">
            <field name="name">National ID Applications</field>
            <field name="description">Helps you manage National ID applications.</field>
            <field name="sequence">100</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_national_id">
            <field name="name">Access Level</field>
            <field name="category_id" ref="module_category_national_id"/>
        </record>

        <record id="group_national_id_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="res_groups_privilege_national_id"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">The user will be able to review and process applications.</field>
        </record>

        <record id="group_national_id_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_national_id"/>
            <field name="implied_ids" eval="[Command.link(ref('group_national_id_officer'))]"/>
            <field name="comment">The user will have full access to applications.</field>
        </record>
        
        <!-- Record Rules -->
        <!-- Internal users (admins, staff, officers, managers) see ALL applications -->
        <record id="national_id_application_internal_rule" model="ir.rule">
            <field name="name">All Applications (Internal Users)</field>
            <field ref="model_national_id_application" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <!-- Portal / public users only see their OWN applications -->
        <record id="national_id_application_personal_rule" model="ir.rule">
            <field name="name">Personal Applications</field>
            <field ref="model_national_id_application" name="model_id"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_public'))]"/>
        </record>

        <!-- Officers explicitly see all (in addition to the internal rule) -->
        <record id="national_id_application_officer_rule" model="ir.rule">
            <field name="name">All Applications (Officer)</field>
            <field ref="model_national_id_application" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[Command.link(ref('group_national_id_officer'))]"/>
        </record>
    </data>
</odoo>
