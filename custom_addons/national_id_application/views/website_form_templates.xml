<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="application_form_template" name="National ID Application Form">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_website_form pt64 pb64 bg-light" data-vcss="001" data-snippet="s_website_form">
                        <div class="container">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-8">
                                    <div class="card shadow-sm border-0 rounded-3">
                                        <div class="card-header bg-primary text-white p-4">
                                            <h2 class="mb-0 text-center">National ID Application</h2>
                                            <p class="text-center mt-2 mb-0">Please fill out the form below to apply for your National ID.</p>
                                        </div>
                                        <div class="card-body p-5">
                                            <form action="/id_application/submit" method="post" enctype="multipart/form-data" class="needs-validation">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                
                                                <div class="row mb-4">
                                                    <div class="col-md-6">
                                                        <label for="applicant_name" class="form-label fw-bold">Full Name *</label>
                                                        <input type="text" class="form-control" name="applicant_name" required="required" placeholder="e.g. John Doe"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="date_of_birth" class="form-label fw-bold">Date of Birth *</label>
                                                        <input type="date" class="form-control" name="date_of_birth" required="required"/>
                                                    </div>
                                                </div>

                                                <div class="row mb-4">
                                                    <div class="col-md-6">
                                                        <label for="gender" class="form-label fw-bold">Gender *</label>
                                                        <select class="form-select" name="gender" required="required">
                                                            <option value="" disabled="1" selected="1">Select Gender</option>
                                                            <option value="male">Male</option>
                                                            <option value="female">Female</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="phone" class="form-label fw-bold">Phone Number *</label>
                                                        <input type="tel" class="form-control" name="phone" required="required" placeholder="e.g. +256..."/>
                                                    </div>
                                                </div>

                                                <div class="mb-4">
                                                    <label for="email" class="form-label fw-bold">Email Address *</label>
                                                    <input type="email" class="form-control" name="email" required="required" placeholder="your@email.com"/>
                                                </div>

                                                <div class="mb-4">
                                                    <label for="address" class="form-label fw-bold">Physical Address *</label>
                                                    <textarea class="form-control" name="address" rows="3" required="required" placeholder="Your residential address..."></textarea>
                                                </div>

                                                <hr class="my-4"/>
                                                <h4 class="mb-3">Attachments</h4>

                                                <div class="mb-4">
                                                    <label for="photo" class="form-label fw-bold">Applicant Photo (Passport Size) *</label>
                                                    <input type="file" class="form-control" name="photo" accept="image/*" required="required"/>
                                                    <div class="form-text">Please upload a clear, recent passport-sized photograph.</div>
                                                </div>

                                                <div class="mb-5">
                                                    <label for="lc_letter" class="form-label fw-bold">LC Reference Letter *</label>
                                                    <input type="file" class="form-control" name="lc_letter" accept=".pdf,.doc,.docx,.jpg,.png" required="required"/>
                                                    <div class="form-text">Attach a scanned copy of your Local Council (LC) recommendation letter.</div>
                                                </div>

                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-primary btn-lg py-3">Submit Application</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <template id="application_thank_you" name="Application Submitted">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="pt64 pb64 text-center">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-6">
                                    <div class="card shadow-sm border-0 py-5">
                                        <div class="card-body">
                                            <i class="fa fa-check-circle text-success" style="font-size: 80px;"></i>
                                            <h2 class="mt-4 mb-3">Application Submitted Successfully!</h2>
                                            <p class="lead text-muted mb-4">
                                                Thank you for your application. Your reference number is: 
                                                <br/>
                                                <strong class="text-primary" style="font-size: 1.5rem;"><t t-esc="application_ref"/></strong>
                                            </p>
                                            <p>You can use this reference to track the status of your application.</p>
                                            <a href="/" class="btn btn-outline-primary mt-3">Return to Homepage</a>
                                            <a t-if="request.env.user.id != request.env.ref('base.public_user').id" href="/my/id_applications" class="btn btn-primary mt-3 ms-2">Go to My Portal</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
