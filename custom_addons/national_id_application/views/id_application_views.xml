<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_national_id_application_form" model="ir.ui.view">
            <field name="name">national.id.application.form</field>
            <field name="model">national.id.application</field>
            <field name="arch" type="xml">
                <form string="National ID Application">
                    <header>
                        <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_review" type="object" string="Review" invisible="state != 'submitted'" class="oe_highlight"/>
                        <button name="action_approve" type="object" string="Approve" invisible="state != 'under_review'" class="oe_highlight"/>
                        <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted', 'under_review')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved,rejected"/>
                    </header>
                    <sheet>
                        <field name="photo_filename" invisible="1"/>
                        <field name="photo" widget="image" class="oe_avatar" options="{'size': [150, 200]}" filename="photo_filename" readonly="state in ('approved', 'rejected')"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="applicant_name" readonly="state in ('approved', 'rejected')"/>
                                <field name="date_of_birth" readonly="state in ('approved', 'rejected')"/>
                                <field name="gender" readonly="state in ('approved', 'rejected')"/>
                                <field name="nin_number" readonly="state in ('approved', 'rejected')"/>
                            </group>
                            <group>
                                <field name="phone" readonly="state in ('approved', 'rejected')"/>
                                <field name="email" readonly="state in ('approved', 'rejected')"/>
                                <field name="partner_id" readonly="state in ('approved', 'rejected')"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Address &amp; Attachments">
                                <group>
                                    <field name="address" readonly="state in ('approved', 'rejected')"/>
                                    <field name="lc_letter_filename" invisible="1"/>
                                    <field name="lc_letter" filename="lc_letter_filename" readonly="state in ('approved', 'rejected')"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_national_id_application_list" model="ir.ui.view">
            <field name="name">national.id.application.list</field>
            <field name="model">national.id.application</field>
            <field name="arch" type="xml">
                <list string="National ID Applications">
                    <field name="name"/>
                    <field name="applicant_name"/>
                    <field name="create_date"/>
                    <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'under_review'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                </list>
            </field>
        </record>

        <record id="action_national_id_application" model="ir.actions.act_window">
            <field name="name">Applications</field>
            <field name="res_model">national.id.application</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No National ID Applications found.
                </p>
            </field>
        </record>

        <menuitem id="menu_national_id_root" name="National ID" sequence="10"/>
        <menuitem id="menu_national_id_applications" name="Applications" parent="menu_national_id_root" action="action_national_id_application" sequence="10"/>
    </data>
</odoo>
